{
  "name": "clevylo-release-tools",
  "private": true,
  "description": "Development tooling for Clevylo GitHub releases; never shipped in the app.",
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "scripts": {
    "test": "node --test scripts/tests/*.test.mjs",
    "release": "semantic-release",
    "release:preview": "semantic-release --dry-run"
  },
  "devDependencies": {
    "@semantic-release/exec": "7.1.0",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "semantic-release": "25.0.9"
  }
}
